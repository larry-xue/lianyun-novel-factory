# LLM (OpenAI-format endpoint) —— 首次启动 fallback；可在 /settings 页面切到 db
LLM_API_ENDPOINT=https://api.openai.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=gpt-4o-mini

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://lianyun:lianyun_dev@localhost:5433/lianyun

# 批量铺量并发：pg-boss worker 同时跑 N 本书。clamp 到 [1, 16]。
# 改了需重启服务（worker config 在启动时 load）。
BATCH_CONCURRENCY=2

# App
NODE_ENV=development
PORT=3000
