{
  "name": "lianyun-novel-factory",
  "version": "0.1.0",
  "private": false,
  "description": "An open-source AI web novel production workbench with agents, living docs, prompt management, batch jobs, and run tracing.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larry-xue/lianyun-novel-factory.git"
  },
  "bugs": {
    "url": "https://github.com/larry-xue/lianyun-novel-factory/issues"
  },
  "homepage": "https://github.com/larry-xue/lianyun-novel-factory#readme",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:cov": "vitest run --coverage",
    "test:e2e": "RUN_LIVE_LLM_TESTS=1 vitest run --reporter=verbose tests/e2e",
    "test:live": "RUN_LIVE_LLM_TESTS=1 vitest run",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker compose exec postgres psql -U lianyun -d lianyun",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed/index.ts",
    "db:reset": "docker compose down -v && pnpm db:up && sleep 3 && pnpm db:migrate && pnpm db:seed",
    "mastra:dev": "mastra dev"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^0.2.0",
    "@mastra/core": "^1.29.1",
    "@mastra/loggers": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.6",
    "@tanstack/react-query": "^5.75.0",
    "@tanstack/react-router": "^1.114.0",
    "@tanstack/react-router-with-query": "^1.114.0",
    "@tanstack/react-start": "^1.114.0",
    "@tanstack/router-plugin": "^1.114.0",
    "ai": "^4.3.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.8.3",
    "lucide-react": "^0.469.0",
    "mermaid": "^11.14.0",
    "pg-boss": "^10.1.5",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.5",
    "jsdom": "^26.0.0",
    "mastra": "^1.7.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^7.3.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.6.5"
}
